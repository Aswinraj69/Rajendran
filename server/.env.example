# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rajendran-kaipallil

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=rk_token

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# YouTube Data API (optional - used to auto-fetch video title/thumbnail/etc.)
YOUTUBE_API_KEY=

# Initial admin account (used by `npm run create-admin`)
ADMIN_NAME=Rajendran Kaipallil
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_now
